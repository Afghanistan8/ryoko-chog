# Copy to agent/.env and fill in. Never commit the real file.

# "testnet" or "mainnet"
NETWORK=testnet

# Optional. Defaults to the public Monad RPC for the chosen network.
RPC_URL=

# RyokoJourney address (the live ones are in packages/shared/src/deployments.ts)
JOURNEY_ADDRESS=

# Testnet only: test contract addresses (also in packages/shared/src/deployments.ts)
TEST_CHOG_GENESIS=
TEST_CHOG_TOKEN=

# Private key of the agent wallet. It pays gas (MON) for every travel and conquer.
# Use a fresh wallet that holds only gas money. Deploy with RESETTER set to its address
# so it can also report hidden transfers.
AGENT_PRIVATE_KEY=

# Seconds between rounds (default 30)
POLL_SECONDS=30

# Simulate only, send nothing (default false)
DRY_RUN=false

# Report Chogs sent away and back (needs the agent to be the journey resetter; default true)
REPORT_TRANSFERS=true

# Warn when the agent's MON balance drops below this many thousandths of a MON (default 500 = 0.5 MON)
LOW_GAS_MILLI_MON=500

# Optional comma-separated IPFS gateways for Chog metadata
IPFS_GATEWAYS=
