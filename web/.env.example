# Optional. Contract addresses live in packages/shared/src/deployments.ts, so the site needs no
# configuration. Copy this file to web/.env.local only to override something, for example to
# point local development at a local chain.

# VITE_MAINNET_JOURNEY=
# VITE_MAINNET_AGENT=
# VITE_MAINNET_RPC_URL=
# VITE_TESTNET_JOURNEY=
# VITE_TESTNET_AGENT=
# VITE_TESTNET_RPC_URL=
# VITE_TESTNET_CHOG_GENESIS=
# VITE_TESTNET_CHOG_TOKEN=

# WalletConnect project id (free at https://dashboard.reown.com) to offer QR-code and mobile
# wallets in the wallet picker. Set it in Vercel's environment variables for the live site.
VITE_WALLETCONNECT_PROJECT_ID=
