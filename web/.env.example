# Copy to web/.env.local and fill in after deploying the contracts (see README).

# "testnet" (free test Chogs and test CHOG) or "mainnet" (real Chog Genesis and $CHOG)
VITE_NETWORK=testnet

# Optional. Defaults to the public Monad RPC for the chosen network.
VITE_RPC_URL=

# RyokoJourney address printed by the deploy script
VITE_JOURNEY_ADDRESS=

# Address of the running Ryoko agent (the AGENT_PRIVATE_KEY's address). Holders appoint it.
VITE_AGENT_ADDRESS=

# Testnet only: test contract addresses printed by the deploy script
VITE_TEST_CHOG_GENESIS=
VITE_TEST_CHOG_TOKEN=

# Optional. WalletConnect project id (free at https://dashboard.reown.com) to offer QR-code and
# mobile wallets in the wallet picker. Without it, browser wallets still work.
VITE_WALLETCONNECT_PROJECT_ID=
