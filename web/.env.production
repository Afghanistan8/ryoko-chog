# Monad mainnet deployment, verified on-chain on 9 Oct 2026. Used by `npm run build` (and so by
# Vercel). Nothing here is secret. Vercel environment variables override these values; `npm run dev`
# ignores this file and uses web/.env.local (testnet).
VITE_NETWORK=mainnet
VITE_RPC_URL=
VITE_JOURNEY_ADDRESS=0xC8E3c576c6aBC7536f7B158220e146aEE44C0725
VITE_AGENT_ADDRESS=0x4184bc5E5444F250767E8D33A49817A9B4FB0df3
